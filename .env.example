# Copy to .env and fill in. Never commit .env.
# (Randy runs this via Dockhand's Environment tab instead, so this file is
# just documentation of every supported variable.)
BAMBU_EMAIL=you@example.com
BAMBU_PASSWORD=your-bambu-account-password
BAMBU_REGION=us
# Leave blank to auto-detect if this account has exactly one printer.
# Find it in Bambu Handy: device -> settings (gear) -> device serial number.
BAMBU_SERIAL=
BAMBU_DEVICE_TYPE=A1
# Long random string you invent. The assistant stores it in its own vault;
# it goes in Dockhand's env tab and in the vault card, nowhere else.
API_KEY=change-me-to-something-long-and-random
PORT=8080
